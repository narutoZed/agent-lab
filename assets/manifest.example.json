        {
          "id": "correctness",
          "description": "关键事实与计算可由提供的输入和产物证据验证",
          "required": true,
          "verification": "answer"
        },
        {
          "id": "artifact",
          "description": "实际产物存在且内容满足任务要求；缺产物内容则未判定",
